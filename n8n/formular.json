    {
      "parameters": {
        "jsCode": "// Bildet die Formularfelder auf das Verordnung-Schema des Prüf-Workflows ab.\n// Fehlende Angaben werden null – geraten wird nichts.\nconst f = $input.first().json;\n\nconst text = (v) => (v === undefined || v === null || String(v).trim() === \"\" ? null : String(v).trim());\nconst zahl = (v) => {\n  const t = String(v ?? \"\").replace(\",\", \".\").trim();\n  if (!t) return null;\n  const n = Number(t);\n  return Number.isFinite(n) ? n : null;\n};\nconst iso = (v) => {\n  const t = text(v);\n  if (!t) return null;\n  const de = /^(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})$/.exec(t);\n  if (de) return de[3] + \"-\" + de[2].padStart(2, \"0\") + \"-\" + de[1].padStart(2, \"0\");\n  return t.slice(0, 10);\n};\n\nconst bereiche = {\n  \"Physiotherapie\": \"physiotherapie\",\n  \"Podologische Therapie\": \"podologie\",\n  \"Stimm-, Sprech-, Sprach- und Schlucktherapie\": \"ssss\",\n  \"Ergotherapie\": \"ergotherapie\",\n  \"Ernährungstherapie\": \"ernaehrung\"\n};\nconst ls = text(f.leitsymptomatik);\n\nconst heilmittel = [];\nfor (const i of [1, 2, 3]) {\n  const name = text(f[\"heilmittel_\" + i]);\n  if (name) heilmittel.push({ name, einheiten: zahl(f[\"einheiten_\" + i]), art: \"vorrangig\" });\n}\nconst ergaenzend = text(f.ergaenzendes_heilmittel);\n\nconst jetzt = new Date();\nconst heute = jetzt.toISOString().slice(0, 10);\nconst uhrzeit = String(jetzt.getHours()).padStart(2, \"0\") + String(jetzt.getMinutes()).padStart(2, \"0\");\nconst krankenkasse = text(f.krankenkasse);\nconst code2 = (text(f.icd10_2) || \"\").toUpperCase() || null;\n\nconst verordnung = {\n  verordnung_ref: \"VO-\" + heute.replace(/-/g, \"\") + \"-\" + uhrzeit,\n  patient: {\n    krankenkasse,\n    nachname: text(f.nachname),\n    vorname: text(f.vorname),\n    geburtsdatum: iso(f.geburtsdatum),\n    kostentraegerkennung: text(f.kostentraegerkennung),\n    versichertennummer: text(f.versichertennummer),\n    versichertenstatus: text(f.versichertenstatus)\n  },\n  bsnr: text(f.bsnr),\n  lanr: text(f.lanr),\n  ausstellungsdatum: iso(f.ausstellungsdatum),\n  pruefdatum: heute,\n  geplanter_beginn: null,\n  zuzahlung: text(f.zuzahlung) === \"Zuzahlung frei\" ? \"frei\" : text(f.zuzahlung) === \"Zuzahlungspflichtig\" ? \"pflicht\" : null,\n  unfallfolgen: f.unfallfolgen === \"ja\",\n  bvg_ser: f.bvg_ser === \"ja\",\n  heilmittelbereich: bereiche[text(f.heilmittelbereich)] ?? null,\n  icd10: (text(f.icd10) || \"\").toUpperCase() || null,\n  icd10_bezeichnung: text(f.icd10_bezeichnung),\n  weitere_diagnosen: code2 ? [{ code: code2, bezeichnung: text(f.icd10_2_bezeichnung) }] : [],\n  nicht_verordnungsrelevant: [],\n  diagnosen: [\n    ...(text(f.icd10) ? [{ code: text(f.icd10).toUpperCase(), bezeichnung: text(f.icd10_bezeichnung), anlass: true }] : []),\n    ...(code2 ? [{ code: code2, bezeichnung: text(f.icd10_2_bezeichnung), anlass: false }] : [])\n  ],\n  diagnosegruppe: (text(f.diagnosegruppe) || \"\").toUpperCase() || null,\n  leitsymptomatik: ls ? ls.charAt(0).toLowerCase() : null,\n  leitsymptomatik_freitext: text(f.leitsymptomatik_freitext),\n  heilmittel,\n  ergaenzendes_heilmittel: ergaenzend ? { name: ergaenzend, einheiten: zahl(f.einheiten_ergaenzend) } : { name: null, einheiten: null },\n  frequenz: text(f.frequenz),\n  therapiebericht: f.therapiebericht === \"ja\",\n  hausbesuch: f.hausbesuch === \"ja\",\n  dringlich: f.dringlich === \"ja\",\n  therapieziele_hinweise: text(f.therapieziele),\n  arzt: { name: null, fachrichtung: null, betriebsstaette: null },\n  unterschrift: true,\n  letzte_behandlung: null,\n  unterbrechungsgrund: null,\n  kostentraeger: krankenkasse,\n  quelle: \"formular\"\n};\n\nreturn [{ json: { verordnung } }];"
      },
      "id": "d4e5f6a7-4444-4d5e-8f60-000000000002",
      "name": "Verordnung bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },

# n8n lokal starten – Vorlage für .env (wird von n8n aus dem Projektordner gelesen)
#
# Kopieren nach .env und die Werte anpassen. Die .env ist per .gitignore
# ausgeschlossen und darf nie committet werden.

# Datenordner der lokalen Instanz (enthält SQLite-Datenbank und Credentials).
N8N_USER_FOLDER=.n8n

# Verschlüsselungsschlüssel für die Credentials im Datenordner.
# Einmal erzeugen und aufbewahren – ohne ihn sind die Credentials unlesbar:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=<32-byte-hex>

# Lokale Oberfläche
N8N_PORT=5678
N8N_HOST=127.0.0.1
# Lokal ohne HTTPS: Cookies ohne Secure-Flag, damit der Login im Browser klappt.
N8N_SECURE_COOKIE=false

# Für eine schlanke lokale Instanz abschalten
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
